# Local edge without Docker (scripts/stack_local.sh): one public site on :8080 for both lanes
# (STACK_EDGE_PORT moves it; tests use a free port). The lane rules live in deploy/lanes.caddy.
# Paths are relative to the repository root, where the script starts Caddy; the shops and the
# router listen on Unix sockets in run/. tests/test_edge_caddy.py runs this file against stubs.
# Same log redaction and header limit as deploy/Caddyfile.
{
	admin off
	auto_https off
	servers {
		max_header_size 16KiB
	}
}

import lanes.caddy

:{$STACK_EDGE_PORT:8080} {
	log {
		output file run/access.log {
			roll_size 100MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Api-Key delete
				resp_headers>Set-Cookie delete
				request>uri query {
					replace current REDACTED
					replace new REDACTED
					replace repeat REDACTED
				}
			}
		}
	}

	import lanes run
}
