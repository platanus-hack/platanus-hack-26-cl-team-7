# Compose edge: one public site for both lanes, the lane rules from lanes.caddy (mounted beside
# this file). The shops and the router listen on Unix sockets in the shared edge-sockets volume,
# mounted at /run/edge. One JSON access-log line per request goes to /var/log/caddy/access.log
# (mode 0644, so the eval replay job, another user, can read it).
# Credential headers are deleted before the line is written, and so are the password query
# values of GET /rest/user/change-password?current=&new=&repeat=.
# max_header_size pins Caddy's default; dashboard/app.py MAX_BODY assumes it.
{
	admin off
	auto_https off
	servers {
		max_header_size 16KiB
	}
}

import lanes.caddy

:80 {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
			mode 0644
			dir_mode 0755
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Api-Key delete
				resp_headers>Set-Cookie delete
				request>uri query {
					replace current REDACTED
					replace new REDACTED
					replace repeat REDACTED
				}
			}
		}
	}

	import lanes /run/edge
}
