# Budget App — Caddyfile
#
# Development:
#   caddy run --config Caddyfile
#   API proxied to Express on :3111
#   Frontend proxied to Vite dev server on :5173
#
# Production (after building frontend):
#   Set NODE_ENV=production on the server process
#   Point to your domain and let Caddy handle HTTPS automatically:
#
# budget.yourdomain.com {
#     reverse_proxy localhost:3111
# }

:2015 {
    reverse_proxy /api/* localhost:3111
    reverse_proxy /* localhost:5173
}
