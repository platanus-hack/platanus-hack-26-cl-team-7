# Compose proxy: forwards everything to the site and writes one JSON access-log line per request.
# The engine (another user) follows /var/log/caddy/access.log on the shared volume, hence mode 0644.
# Credential headers are deleted before the line is written.
{
	admin off
	auto_https off
}

:80 {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
			mode 0644
			dir_mode 0755
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Api-Key delete
				resp_headers>Set-Cookie delete
			}
		}
	}
	reverse_proxy site:3000
}
